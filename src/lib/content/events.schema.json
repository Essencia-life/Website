{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Events",
	"type": "object",
	"required": ["events"],
	"properties": {
		"events": {
			"type": "array",
			"items": {
				"type": "object",
				"title": "Event",
				"additionalProperties": false,
				"properties": {
					"slug": {
						"title": "Slug",
						"type": "string"
					},
					"title": {
						"title": "Title",
						"type": "string"
					},
					"cover_image": {
						"title": "Cover Image",
						"type": "string",
						"format": "uri"
					},
					"short_description": {
						"title": "Short Description",
						"type": "string"
					},
					"description": {
						"title": "Description",
						"type": "string",
						"widget": "markdown"
					},
					"start": {
						"title": "Start time",
						"type": "string",
						"format": "datetime"
					},
					"end": {
						"title": "End time",
						"type": "string",
						"format": "datetime"
					},
					"weekly": {
						"title": "Weekly",
						"type": "string"
					},
					"type": {
						"title": "Type",
						"type": "string",
						"enum": ["event", "retreat"]
					},
					"booking_link": {
						"title": "Booking Link",
						"type": "string",
						"format": "uri"
					},
					"info_link": {
						"title": "More Information Link",
						"type": "string",
						"format": "uri"
					},
					"car_sharing_link": {
						"title": "Car Sharing Link",
						"type": "string",
						"format": "uri"
					},
					"organizers": {
						"type": "array",
						"items": {
							"type": "object",
							"title": "Event",
							"additionalProperties": false,
							"properties": {
								"name": {
									"type": "string"
								},
								"photo": {
									"type": "string",
									"format": "uri"
								},
								"description": {
									"type": "string"
								}
							}
						}
					}
				}
			}
		}
	}
}
